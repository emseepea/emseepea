{
  "name": "@emseepea/server",
  "version": "0.25.3",
  "description": "Fastify-first framework for Model Context Protocol 2026-07-28 servers over Streamable HTTP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emseepea/emseepea.git",
    "directory": "packages/framework"
  },
  "homepage": "https://emseepea.github.io/emseepea/",
  "bugs": "https://github.com/emseepea/emseepea/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./external-approval": {
      "types": "./dist/external-approval.d.ts",
      "import": "./dist/external-approval.js"
    },
    "./events-postgres": {
      "types": "./dist/events-postgres.d.ts",
      "import": "./dist/events-postgres.js"
    },
    "./events-postgres-lifecycle": {
      "types": "./dist/events-postgres-lifecycle.d.ts",
      "import": "./dist/events-postgres-lifecycle.js"
    },
    "./events-google-worker": {
      "types": "./dist/events-google-worker.d.ts",
      "import": "./dist/events-google-worker.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.type-tests.json",
    "test": "npm run test:built",
    "test:built": "node --test test/*.test.js",
    "test:postgres": "node test/with-postgres-capture.mjs",
    "test:postgres:lifecycle": "node test/with-postgres-lifecycle.mjs",
    "test:postgres:delivery": "node test/with-postgres-delivery.mjs",
    "test:postgres:dispatch": "node test/with-postgres-dispatch.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/fastify": "2.0.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "fastify": "5.12.6",
    "zod": "4.6.6"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "google-auth-library": "11.3.1",
    "google-logging-utils": "2.1.0"
  },
  "peerDependenciesMeta": {
    "google-auth-library": {
      "optional": true
    },
    "google-logging-utils": {
      "optional": true
    }
  }
}
