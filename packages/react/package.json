{
  "name": "@emseepea/react",
  "version": "0.0.2",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emseepea/emseepea.git",
    "directory": "packages/react"
  },
  "homepage": "https://emseepea.github.io/emseepea/examples/",
  "bugs": "https://github.com/emseepea/emseepea/issues",
