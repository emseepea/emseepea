    "test:built": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@emseepea/server": "0.11.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "svelte": "5.57.0"
  },
  "engines": {
    "node": ">=22"
  }
}
