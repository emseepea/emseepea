{
  "name": "@emseepea/testing",
  "version": "0.15.0",
  "description": "MCP integration and semantic testing helpers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emseepea/emseepea.git",
    "directory": "packages/testing"
  },
  "homepage": "https://emseepea.github.io/emseepea/ai-tests/",
  "bugs": "https://github.com/emseepea/emseepea/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./semantic": {
      "types": "./semantic/test.d.mts",
      "import": "./semantic/test.mjs"
    }
  },
  "bin": {
    "emseepea-contract": "./published-contract/cli.mjs",
    "emseepea-test": "./semantic/cli.mjs"
  },
  "files": [
    "dist",
    "published-contract",
    "semantic",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && npm run test:built",
    "test:built": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@emseepea/server": "0.14.0",
    "@modelcontextprotocol/client": "2.0.0"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
