{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "target": "ES2023",
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*"
  ]
}
