{
  "name": "emseepea",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "website"
  ],
  "scripts": {
    "website:dev": "npm run dev -w @emseepea/website",
    "website:build": "npm run build -w @emseepea/website",
    "benchmark": "npm run build && node --expose-gc benchmarks/json-boundary.mjs && node --expose-gc benchmarks/json-boundary.mjs --telemetry",
    "test:load:streaming": "node --expose-gc --test tests/load/proxy-progress.test.mjs",
    "build": "npm run build -w @emseepea/server -w @emseepea/example-ui-shared && npm run build --workspaces --if-present",
    "claude:login": "claude auth login",
    "claude:prepare": "node node_modules/@anthropic-ai/claude-code/install.cjs",
    "changeset": "changeset",
    "check": "npm test",
    "decisions:check": "node scripts/generate-decisions-compendium.mjs --check",
    "decisions:generate": "node scripts/generate-decisions-compendium.mjs",
    "release": "changeset publish --tag next",
    "start:basic": "npm run start -w @emseepea/example-basic-no-ui",
    "start:backend": "npm run start -w @emseepea/example-backend-no-ui",
    "start:protected": "npm run start -w @emseepea/example-protected-no-ui",
    "start:resources-prompts": "npm run start -w @emseepea/example-resources-prompts",
    "start:native-ui": "npm run start -w @emseepea/example-native-ui",
    "start:multi-instance": "npm run start -w @emseepea/example-multi-instance",
    "start:react-ui": "npm run start -w @emseepea/example-react-tailwind-ui",
    "start:streaming": "npm run start -w @emseepea/example-streaming-progress",
    "test": "npm run decisions:check && npm run lint && npm run build && npm run typecheck && npm run test:examples && node --experimental-test-module-mocks --test --test-concurrency=1 tests/black-box/*.test.mjs tests/docs/*.test.mjs tests/llm/*.test.mjs",
    "test:examples": "npm run test:built --workspaces --if-present",
    "test:eval": "npm run build && npm run test:llm:built --workspaces --if-present",
    "test:eval:ci": "npm run test:llm:built --workspaces --if-present -- --provider claude-ci",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p website/tsconfig.json --noEmit",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "lint": "oxlint ."
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace": "2.10.0",
    "@anthropic-ai/claude-code": "2.1.248",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@emseepea/testing": "0.2.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.13.3",
    "axe-core": "4.13.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "zod": "4.4.3",
    "oxlint": "1.80.0"
  }
}
