---
import DefaultSearch from '@astrojs/starlight/components/Search.astro';
---

<DefaultSearch {...Astro.props} />

<script>
  // Retain Pagefind's search UI; repair labels and announcements after it mounts.
  const search = document.querySelector('site-search');
  const dialog = search?.querySelector('dialog');
  if (search && dialog) {
    const trigger = search.querySelector<HTMLButtonElement>('button[data-open-modal]');
    const closeMenu = () => {
      const menu = document.querySelector<HTMLElement & { setExpanded: (expanded: boolean) => void }>(
        'starlight-menu-button[data-expanded="true"]',
      );
      if (!menu) return;
      menu.setExpanded(false);
      // Native dialog focus return must not remember a now-hidden sidebar link.
      trigger?.focus();
    };
    trigger?.addEventListener('click', closeMenu, { capture: true });
    window.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key === 'k' && !dialog.open) closeMenu();
    }, { capture: true });
    const status = document.createElement('p');
    status.className = 'sr-only';
    status.setAttribute('role', 'status');
    status.setAttribute('aria-live', 'polite');
    status.setAttribute('aria-atomic', 'true');
    dialog.append(status);
    const update = () => {
      const input = search.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
      if (input) input.setAttribute('aria-label', input.title || 'Search');
      const message = search.querySelector('.pagefind-ui__message')?.textContent ?? '';
      if (status.textContent !== message) status.textContent = message;
    };
    new MutationObserver(update).observe(search, { childList: true, subtree: true, characterData: true });
    update();
  }
</script>
